<?xml version="1.0" encoding="utf-8"?>
<!--
  配布用ビルドの設定（GitHub Actions とローカルで共通）。
  dotnet publish src/VRCLogAnalyzer -c Release -p:PublishProfile=win-x64 -o <出力先>
  （-c Release は Directory.Build.props の Release 用設定を効かせるため明示する）

  - ランタイム同梱（.NET 10 が入っていない PC でも展開するだけで動く）
  - exe 1 つにまとめる（NLog.config / VRCLogAnalyzer.config は exe の隣に置かれる）
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- SQLite・WPF のネイティブ DLL も exe に含める（初回起動時に一時フォルダへ展開される） -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
</Project>

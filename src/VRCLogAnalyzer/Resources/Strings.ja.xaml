<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <!-- 日本語。キーを追加する場合は Strings.en.xaml にも必ず追加すること -->

  <sys:String x:Key="Common.OK">OK</sys:String>
  <sys:String x:Key="Common.Cancel">キャンセル</sys:String>

  <!-- メニュー -->
  <sys:String x:Key="Menu.File">ファイル(_F)</sys:String>
  <sys:String x:Key="Menu.Update">データ更新(_U)</sys:String>
  <sys:String x:Key="Menu.Export">表示中の結果を CSV エクスポート(_E)...</sys:String>
  <sys:String x:Key="Menu.ShowDetail">詳細表示(_D)</sys:String>
  <sys:String x:Key="Menu.Settings">設定(_S)...</sys:String>
  <sys:String x:Key="Menu.Exit">終了(_X)</sys:String>
  <sys:String x:Key="Menu.Help">ヘルプ(_H)</sys:String>
  <sys:String x:Key="Menu.FirstHelp">はじめて利用される方へ(_U)</sys:String>
  <sys:String x:Key="Menu.Readme">README(_R)（ブラウザが開きます）</sys:String>
  <sys:String x:Key="Menu.Credit">クレジット(_C)</sys:String>

  <!-- 検索条件 -->
  <sys:String x:Key="Filter.StartDate">開始日:</sys:String>
  <sys:String x:Key="Filter.EndDate">終了日:</sys:String>
  <sys:String x:Key="Range.Today">今日</sys:String>
  <sys:String x:Key="Range.Week">7日</sys:String>
  <sys:String x:Key="Range.Month">30日</sys:String>
  <sys:String x:Key="Range.All">全期間</sys:String>
  <sys:String x:Key="Filter.User">ユーザー名:</sys:String>
  <sys:String x:Key="Filter.World">ワールド名:</sys:String>
  <sys:String x:Key="Filter.Keyword">キーワード:</sys:String>
  <sys:String x:Key="Filter.NameTooltip">部分一致（英字の大文字小文字は区別しない）</sys:String>
  <sys:String x:Key="Filter.KeywordTooltip">ワールド名・ユーザー名・ID・動画URL・エラー文を横断して部分一致検索</sys:String>
  <sys:String x:Key="Filter.ExcludeSelf">自分を除外</sys:String>
  <sys:String x:Key="Filter.GroupByVisit">ワールド訪問ごとにまとめる</sys:String>
  <sys:String x:Key="Filter.Search">検索</sys:String>

  <!-- イベント種別 -->
  <sys:String x:Key="EventType.WorldEnter">ワールド入室</sys:String>
  <sys:String x:Key="EventType.WorldLeave">ワールド退室</sys:String>
  <sys:String x:Key="EventType.PlayerJoin">Join</sys:String>
  <sys:String x:Key="EventType.PlayerLeave">Leave</sys:String>
  <sys:String x:Key="EventType.Video">動画</sys:String>
  <sys:String x:Key="EventType.Invite">インバイト</sys:String>
  <sys:String x:Key="EventType.RequestInvite">リクエストインバイト</sys:String>
  <sys:String x:Key="EventType.Error">エラー</sys:String>

  <!-- 一覧 -->
  <sys:String x:Key="Column.Time">日時</sys:String>
  <sys:String x:Key="Column.Type">種別</sys:String>
  <sys:String x:Key="Column.World">ワールド</sys:String>
  <sys:String x:Key="Column.User">ユーザー</sys:String>
  <sys:String x:Key="Column.Detail">詳細</sys:String>
  <sys:String x:Key="Group.BeforeEnter">（ワールド入室前）</sys:String>

  <sys:String x:Key="Ctx.CopyUser">ユーザー名をコピー</sys:String>
  <sys:String x:Key="Ctx.CopyWorld">ワールド名をコピー</sys:String>
  <sys:String x:Key="Ctx.CopyDetail">詳細をコピー</sys:String>
  <sys:String x:Key="Ctx.CopyRows">選択行をコピー（タブ区切り）</sys:String>
  <sys:String x:Key="Ctx.FilterUser">このユーザーで絞り込み</sys:String>
  <sys:String x:Key="Ctx.FilterWorld">このワールドで絞り込み</sys:String>
  <sys:String x:Key="Ctx.OpenWorld">ワールドのページを開く</sys:String>
  <sys:String x:Key="Ctx.OpenUser">ユーザーのページを開く</sys:String>
  <sys:String x:Key="Ctx.OpenVideo">動画 URL を開く</sys:String>

  <sys:String x:Key="Detail.World">ワールド: </sys:String>
  <sys:String x:Key="Detail.User">ユーザー: </sys:String>
  <sys:String x:Key="Detail.Self">  [自分]</sys:String>

  <!-- ステータス（{0} などは書式の埋め込み位置） -->
  <sys:String x:Key="Status.Checking">ログを確認しています…</sys:String>
  <sys:String x:Key="Status.Importing">ログを取り込んでいます… ({0}/{1})</sys:String>
  <sys:String x:Key="Status.ImportDone">取り込み完了: 新規 {0} 件（ログ {1} ファイル中 {2} は変更なし）。</sys:String>
  <sys:String x:Key="Status.LegacyMigrated">旧バージョンのデータ {0} 件を移行しました。</sys:String>
  <sys:String x:Key="Status.ImportFailed">ログ取り込みに失敗しました: {0}</sys:String>
  <sys:String x:Key="Status.Count">{0:N0} 件</sys:String>
  <sys:String x:Key="Status.Truncated">{0:N0} 件を超えたため先頭 {0:N0} 件のみ表示しています。条件を絞り込んでください。</sys:String>
  <sys:String x:Key="Status.Copied">コピーしました: {0}</sys:String>
  <sys:String x:Key="Status.CopyFailed">クリップボードにコピーできませんでした。他のアプリがクリップボードを使用中の可能性があります。</sys:String>

  <sys:String x:Key="Export.Filter">CSVファイル|*.csv|すべてのファイル|*.*</sys:String>
  <sys:String x:Key="Export.Done">{0:N0} 件を CSV ファイルに出力しました。</sys:String>
  <sys:String x:Key="Export.Failed" xml:space="preserve">CSV ファイルを書き込めませんでした。&#10;{0}</sys:String>

  <sys:String x:Key="Error.Unexpected" xml:space="preserve">想定外のエラーが発生しました。&#10;{0}&#10;&#10;詳細は VRCLogAnalyzer.log を確認してください。</sys:String>

  <!-- データベースの安全確認 -->
  <sys:String x:Key="Db.BackupNotice" xml:space="preserve">旧バージョン（または古い形式）のデータベースが見つかったため、新しい形式に移行しました。&#10;移行前のデータベースは、次のファイルにバックアップしてあります。&#10;&#10;{0}&#10;&#10;今後は移行後のデータベースをそのまま使います。新しいバージョンで問題が無いことを確認できたら、バックアップは削除して構いません。</sys:String>
  <sys:String x:Key="Db.Newer" xml:space="preserve">このデータベースは、より新しいバージョンの VRCLogAnalyzer で作成されています。&#10;データを壊さないよう、このバージョンでは開かずに終了します。最新版のアプリをお使いください。&#10;&#10;{0}</sys:String>
  <sys:String x:Key="Db.Unrecognized" xml:space="preserve">VRCLogAnalyzer のデータベースとして認識できないファイルです。&#10;データを壊さないよう、開かずに終了します。&#10;&#10;{0}&#10;&#10;ファイルを別の場所に移すか、設定ファイル（VRCLogAnalyzer.config）でデータベースの保存場所を変更してください。</sys:String>
  <sys:String x:Key="Args.Unknown" xml:space="preserve">認識できない起動オプションがあるため、何もせずに終了します。&#10;&#10;{0}&#10;&#10;使用できるオプション: /analyze, /db &lt;パス&gt;, /logdir &lt;パス&gt;（-analyze や --analyze の形式も使えます）</sys:String>

  <!-- 設定 -->
  <sys:String x:Key="Settings.Title">設定</sys:String>
  <sys:String x:Key="Settings.DbLocation">データベースファイル保存場所</sys:String>
  <sys:String x:Key="Settings.MyDocuments">マイドキュメントの VRCLogAnalyzer フォルダ（推奨）</sys:String>
  <sys:String x:Key="Settings.AppPath">アプリ実行ファイルと同じフォルダ</sys:String>
  <sys:String x:Key="Settings.DbNote">※保存場所を変更した場合、変更前のデータを引き継ぐには変更前のフォルダの「VRCLogAnalyzer.db」を変更後のフォルダに移動してください。</sys:String>
  <sys:String x:Key="Settings.CurrentDb">現在使用中のデータベースファイル:</sys:String>
  <sys:String x:Key="Settings.LogDir">VRChat のログフォルダ</sys:String>
  <sys:String x:Key="Settings.Browse">参照...</sys:String>
  <sys:String x:Key="Settings.LogDirDefault">空欄の場合は既定のフォルダを使用します: {0}</sys:String>
  <sys:String x:Key="Settings.Language">表示言語 / Language</sys:String>
  <sys:String x:Key="Settings.LanguageAuto">自動（Windows の設定に合わせる）</sys:String>
  <sys:String x:Key="Settings.SaveFailed" xml:space="preserve">設定ファイルを保存できませんでした。&#10;{0}</sys:String>

  <!-- ヘルプ・クレジット -->
  <sys:String x:Key="Help.Title">はじめて利用される方へ</sys:String>
  <sys:String x:Key="Help.Body" xml:space="preserve">VRCLogAnalyzer をご利用いただき、ありがとうございます！&#10;&#10;このアプリは VRChat のログを解析して、訪れたワールド、同じインスタンスにいたユーザーの Join / Leave、再生された動画 URL、エラー、自分宛てのインバイトを記録し、条件を指定して検索できます。&#10;&#10;ログの取り込みはアプリ起動時に自動で行われます（2 回目以降は増えた分だけを取り込みます）。手動で取り込む場合は「ファイル」メニューの「データ更新」を選択してください。&#10;&#10;VRChat のログは数日で削除されるため、継続して記録する場合はタスクスケジューラなどで 1 日 1 回以上「VRCLogAnalyzer.exe /analyze」を実行するよう設定してください。ウィンドウを開かずにデータ更新だけを行います。&#10;&#10;旧バージョンのデータベースが同じ場所にある場合は、初回の取り込み時に自動で新しい形式へ移行されます（旧データはそのまま残ります）。&#10;&#10;よき VRChat ライフを！</sys:String>
  <sys:String x:Key="Credit.Title">クレジット</sys:String>
  <sys:String x:Key="Credit.OriginalHeading">原作者</sys:String>
  <sys:String x:Key="Credit.OriginalDesc">オリジナルの VRCLogAnalyzer の作者です。本アプリは、このアプリ（MIT ライセンス）をもとに不具合修正と機能追加を行ったものです。</sys:String>
  <sys:String x:Key="Credit.ForksHeading">不具合修正の参考にさせていただいた fork</sys:String>
  <sys:String x:Key="Credit.ForkTkrDesc">ウィンドウのリサイズ時に一覧や検索ボタンが隠れる問題の修正</sys:String>
  <sys:String x:Key="Credit.ForkYuiDesc">ロケール（地域設定）により日付検索ができない問題の修正、.NET 8 対応</sys:String>
  <sys:String x:Key="Credit.LibrariesHeading">使用しているライブラリ</sys:String>
  <sys:String x:Key="Credit.DisclaimerHeading">免責事項</sys:String>
  <sys:String x:Key="Credit.DisclaimerBody" xml:space="preserve">本アプリは VRChat 社とは関係のない有志のアプリです。&#10;&#10;オープンソースソフトウェアとして AS-IS で配布され、開発者はこのソフトウェアを利用したことによるいかなる損害の責任も負いません。&#10;&#10;将来の VRChat の仕様変更により本アプリが利用できなくなった場合の対応を保証するものではありません。</sys:String>
</ResourceDictionary>

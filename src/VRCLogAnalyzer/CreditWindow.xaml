<Window x:Class="VRCLogAnalyzer.CreditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Credit.Title}"
        SizeToContent="Height"
        MaxHeight="760"
        Width="540"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <!-- 見出し -->
    <Style x:Key="Heading" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Margin" Value="0 16 0 6" />
    </Style>
    <!-- 作者名・ライブラリ名 -->
    <Style x:Key="Name" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="8 6 0 0" />
    </Style>
    <!-- 説明・リンク（名前の下に字下げして表示） -->
    <Style x:Key="Desc" TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="20 2 0 0" />
    </Style>
  </Window.Resources>

  <DockPanel Margin="16">
    <Button DockPanel.Dock="Bottom" Content="{DynamicResource Common.OK}" Width="80" Height="28" Margin="0 16 0 0"
            IsDefault="True" IsCancel="True" />
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock x:Name="AppTitle" FontSize="18" FontWeight="Bold" />
        <TextBlock Text="copyright (c) sechiro 2021" Foreground="DimGray" Margin="0 2 0 0" />

        <!-- 原作者 -->
        <TextBlock Style="{StaticResource Heading}" Text="{DynamicResource Credit.OriginalHeading}" />
        <TextBlock Style="{StaticResource Name}" Text="sechiro" />
        <TextBlock Style="{StaticResource Desc}" Text="{DynamicResource Credit.OriginalDesc}" />
        <TextBlock Style="{StaticResource Desc}">
          <Hyperlink NavigateUri="https://github.com/sechiro/VRCLogAnalyzer" RequestNavigate="Link_RequestNavigate">https://github.com/sechiro/VRCLogAnalyzer</Hyperlink>
        </TextBlock>

        <!-- 不具合修正の参考にさせていただいた fork -->
        <TextBlock Style="{StaticResource Heading}" Text="{DynamicResource Credit.ForksHeading}" />
        <TextBlock Style="{StaticResource Name}" Text="TK-R" />
        <TextBlock Style="{StaticResource Desc}" Text="{DynamicResource Credit.ForkTkrDesc}" />
        <TextBlock Style="{StaticResource Desc}">
          <Hyperlink NavigateUri="https://github.com/TK-R/VRCLogAnalyzer" RequestNavigate="Link_RequestNavigate">https://github.com/TK-R/VRCLogAnalyzer</Hyperlink>
        </TextBlock>

        <TextBlock Style="{StaticResource Name}" Text="yui0471" Margin="8 12 0 0" />
        <TextBlock Style="{StaticResource Desc}" Text="{DynamicResource Credit.ForkYuiDesc}" />
        <TextBlock Style="{StaticResource Desc}">
          <Hyperlink NavigateUri="https://github.com/yui0471/VRCLogAnalyzer" RequestNavigate="Link_RequestNavigate">https://github.com/yui0471/VRCLogAnalyzer</Hyperlink>
        </TextBlock>

        <!-- 使用しているライブラリ -->
        <TextBlock Style="{StaticResource Heading}" Text="{DynamicResource Credit.LibrariesHeading}" />
        <TextBlock Style="{StaticResource Name}" Text=".NET / WPF" />
        <TextBlock Style="{StaticResource Desc}" Text="MIT License" />
        <TextBlock Style="{StaticResource Name}" Text="sqlite-net-pcl / SQLitePCLRaw / SQLite" />
        <TextBlock Style="{StaticResource Desc}" Text="MIT License / Apache License 2.0 / Public Domain" />
        <TextBlock Style="{StaticResource Name}" Text="NLog" />
        <TextBlock Style="{StaticResource Desc}" Text="BSD 3-Clause License" />

        <!-- 免責事項 -->
        <TextBlock Style="{StaticResource Heading}" Text="{DynamicResource Credit.DisclaimerHeading}" />
        <TextBlock Text="{DynamicResource Credit.DisclaimerBody}" TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>

<Window x:Class="VRCLogAnalyzer.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Help.Title}"
        SizeToContent="Height"
        Width="460"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="14">
    <TextBlock Text="{DynamicResource Help.Body}" TextWrapping="Wrap" />
    <Button Content="{DynamicResource Common.OK}" Width="80" Height="28" Margin="0 14 0 0" IsDefault="True" IsCancel="True" />
  </StackPanel>
</Window>

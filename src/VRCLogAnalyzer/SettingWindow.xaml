<Window x:Class="VRCLogAnalyzer.SettingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Settings.Title}"
        SizeToContent="Height"
        Width="520"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="14">
    <TextBlock Text="{DynamicResource Settings.Language}" FontSize="14" FontWeight="Bold" Margin="0 0 0 8" />
    <ComboBox x:Name="LanguageCombo" HorizontalAlignment="Left" MinWidth="260" DisplayMemberPath="Label" SelectedValuePath="Code" />

    <TextBlock Text="{DynamicResource Settings.DbLocation}" FontSize="14" FontWeight="Bold" Margin="0 16 0 8" />
    <RadioButton x:Name="DbPathConfigMyDocuments" Content="{DynamicResource Settings.MyDocuments}" Margin="0 0 0 4" />
    <RadioButton x:Name="DbPathConfigAppPath" Content="{DynamicResource Settings.AppPath}" Margin="0 0 0 4" />
    <TextBlock Text="{DynamicResource Settings.DbNote}" TextWrapping="Wrap" Foreground="DimGray" Margin="0 4 0 0" />
    <TextBlock Text="{DynamicResource Settings.CurrentDb}" Margin="0 8 0 2" />
    <!-- 選択してコピーできるよう読み取り専用の TextBox で表示する -->
    <TextBox x:Name="CurrentDbText" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Foreground="DimGray" />

    <TextBlock Text="{DynamicResource Settings.LogDir}" FontSize="14" FontWeight="Bold" Margin="0 16 0 8" />
    <DockPanel>
      <Button DockPanel.Dock="Right" Content="{DynamicResource Settings.Browse}" Padding="10 2" Margin="6 0 0 0" Click="Button_BrowseLogDir" />
      <TextBox x:Name="LogDirText" Height="24" VerticalContentAlignment="Center" />
    </DockPanel>
    <TextBlock x:Name="DefaultLogDirText" TextWrapping="Wrap" Foreground="DimGray" Margin="0 4 0 0" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 16 0 0">
      <Button Content="{DynamicResource Common.OK}" Width="80" Height="28" IsDefault="True" Click="Button_Click_OK" Margin="0 0 8 0" />
      <Button Content="{DynamicResource Common.Cancel}" Width="80" Height="28" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
